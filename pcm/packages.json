  {
   "$schema": "https://go.kicad.org/pcm/schemas/v1",
   "name": "PartReel Fetch",
   "description": "Search PartReel and add just the parts you pick to the current project.",
   "description_full": "Adds a PartReel search dialog to the PCB editor toolbar.\nSearch the full PartReel registry (21,000+ parts, no login), pick a part, and only that part's symbol and footprint are downloaded into the current project (PartReel.kicad_sym / PartReel.pretty) and registered in the project library tables.\nUse this instead of installing a whole library when you only need a few parts. Requires network access to partreel.com.",
   "identifier": "com.partreel.fetch",
   "type": "plugin",
   "author": {
    "name": "PartReel",
    "contact": {
     "web": "https://partreel.com"
    }
